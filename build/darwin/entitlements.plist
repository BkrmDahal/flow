<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for JIT compilation (JS execution inside the WebView) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required to allow loading unsigned executable memory or dynamically linked libraries -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for the application to make outgoing network requests (e.g. calling APIs) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Required if the application spawns or debugs sub-processes -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
